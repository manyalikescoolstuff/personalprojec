# GetDone Environment Variables Template
# Copy this file to .env.local to configure AI Vision and Firebase Backend

# ==============================================================================
# 1. Firebase Backend Configuration (Auth + Firestore + Storage)
# ==============================================================================
# Obtain these from your Firebase Console -> Project Settings -> General -> Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==============================================================================
# 2. AI Vision & Multimodal Extraction (Optional / Configurable)
# ==============================================================================
# Google Gemini Vision (Recommended)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional alternative model: gemini-2.0-flash (default) | gemini-1.5-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# OpenAI Vision (Optional Alternative)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Anthropic Claude Vision (Optional Alternative)
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Explicit Vision Provider Selection (Optional)
# Options: 'gemini' | 'openai' | 'anthropic'
# If unset, automatically uses the first configured API key (Gemini -> OpenAI -> Anthropic)
VISION_PROVIDER=gemini
